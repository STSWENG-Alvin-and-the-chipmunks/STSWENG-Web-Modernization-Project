<article class="bk-card" data-id="{{_id}}" data-slug="{{slug}}">

  <div class="bk-menu">
    <button type="button" class="bk-menu-btn" aria-haspopup="true" aria-expanded="false">•••</button>
    <ul class="bk-menu-list" role="menu">
      <li role="menuitem"><a class="bk-edit" href="/admin/blog/edit/{{_id}}">Edit</a></li>
      <li role="menuitem"><button type="button" class="bk-delete" data-id="{{_id}}" data-title="{{title}}">Delete</button></li>
    </ul>
  </div>

    <div class="bk-meta">
      <div class="bk-avatar"></div>
      <span class="bk-author">{{author}}</span>
      <span class="bk-dot"></span>
      <span class="bk-date">{{createdAt}}</span>
    </div>

    <a class="bk-link-wrapper" href="/posts/{{_id}}">

    <h3 class="bk-title">
      {{title}}
    </h3>
    </a>

    {{#if content}}<p class="bk-sub">{{content}}</p>{{/if}}

    {{#if tags}}
      <div class="bk-tags">
        {{#each tags}}<span class="bk-tag">#{{this}}</span>{{/each}}
      </div>
    {{/if}}

  </a>
  </article>