<div class="article-wrapper">

  {{#with post}}
  <div class="blog-post-detail-page">

    {{!-- 1. Hero Image & Caption --}}
    <figure class="post-hero-image">
      <img src="{{heroImage}}">

      {{#if imageCredit}}
      <figcaption class="post-hero-caption">
        {{imageCredit}}
      </figcaption>
      {{/if}}
    </figure>

    {{!-- Container for the text content --}}
    <main class="post-content-container">

      {{!-- 2. Title --}}
      <h1 class="post-main-title">{{title}}</h1>
      
      {{!-- 3. Subtitle --}}
      {{#if subtitle}}
      <p class="post-subtitle">{{subtitle}}</p>
      {{/if}}

      {{!-- 4. Author & Read Time --}}
      <div class="post-author-meta">
        <div class="author-avatar"></div>
        <div class="author-info">
          {{!-- This now points to the populated author's username --}}
          {{#if author}}
            <span class="author-name">{{author.username}}</span>
          {{else}}
            <span class="author-name">Unknown Author</span>
          {{/if}}
          <span class="meta-separator">•</span>
          <span class="read-time">{{readTime}}</span>
        </div>
      </div>

      {{!-- 5. Action Bar --}}
      <div class="post-action-bar">
        <div class="action-group">
          <button class="action-icon" aria-label="Upvote">
            <img src="/assets/Upvote.png" alt="Upvote"> {{upvotes}}
          </button>
          <button class="action-icon" aria-label="Comment">
          <img src="/assets/Comment.png" alt="Comment"> {{comments.length}} 
          </button>
        </div>
        <div class="action-group">
          {{!-- These buttons only have an icon --}}
          <button class="action-icon" aria-label="Save post">
            <img src="/assets/Save.png" alt="Save post">
          </button>
          <button class="action-icon" aria-label="Share post">
            <img src="/assets/Share.png" alt="Share post">
          </button>
        </div>
      </div>

      {{!-- 6. Main Body Content --}}
      <div class="post-body">
        {{{content}}}
      </div>

    </main>
  </div>
  {{/with}}

    {{!-- Comments Section --}}
  <div class="post-content-container">
    <div class="comments-section-wrapper">

      {{!-- A. The "Add Comment" Area --}}
      <div class="comment-input-row">
        {{!-- User Avatar (Placeholder or Real) --}}
        <div class="avatar-circle">
          {{#if user.profilePic}}
             <img src="{{user.profilePic}}" alt="User">
          {{else}}
             <div class="avatar-placeholder">{{user.username.[0]}}</div>
          {{/if}}
        </div>

        <div class="input-container">
          {{#if user}}
            <form action="/blog/{{post._id}}/comment" method="POST" class="modern-comment-form">
            <textarea name="content" placeholder="What are your thoughts?" required></textarea>
            <button type="submit" class="send-btn">Post</button>
            </form>
          {{else}}
            <div class="login-prompt-bar">
              <span><a href="/login">Log in</a> to share your thoughts.</span>
            </div>
          {{/if}}
        </div>
      </div>

      <div class="divider-line"></div>

      {{!-- B. The List of Comments --}}
      <div class="comments-list">
        {{#if post.comments}}
          {{#each post.comments}}
            <div class="comment-item">

              {{!-- Left: Avatar --}}
              <div class="comment-avatar-col">
                 <div class="avatar-circle small">
                   {{#if this.author.profilePic}}
                     <img src="{{this.author.profilePic}}" alt="User">
                   {{else}}
                     {{!-- Fallback if no image --}}
                     <div class="avatar-placeholder">{{this.author.username.[0]}}</div>
                   {{/if}}
                 </div>
              </div>

              {{!-- Right: Content --}}
              <div class="comment-main">
                <div class="comment-header">
                  <div class="meta-left">
                    <span class="comment-author-name">{{this.author.username}}</span>
                    {{!-- Format this date using JS or a helper later --}}
                    <span class="comment-date">{{this.createdAt}}</span>
                  </div>
                  {{!-- The "Three Dots" menu from screenshot --}}
                  <div class="comment-menu">•••</div>
                </div>

                <div class="comment-text">
                  {{this.content}}
                </div>

                {{!-- Footer: Replies / Actions --}}
                <div class="comment-footer">
                  <div class="action-item">
                    <button class="action-icon" aria-label="Comment-reply">
                      <img src="/assets/Comment.png" alt="Comment-reply"> {{comments-reply}}
                      <span>Reply</span>
                    </button>
                  </div>
                </div>
              </div>

            </div>
          {{/each}}
        {{else}}
          <p class="no-comments">No comments yet.</p>
        {{/if}}
      </div>
    </div>
  </div>
</div>