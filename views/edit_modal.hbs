<section class="under-fixed-nav"></section>
  <div class="blog-create-container">
    <div class="editor-area">
      <div class="top-actions">
          <button class="btn btn-secondary" aria-label="Save Draft">
            <img src="/assets/Save_Draft.png" alt="Save Draft"> Save Draft
          </button>
          <button class="btn btn-outline-primary" aria-label="Preview">
            <img src="/assets/Preview.png" alt="Preview"> Preview
          </button>
          <button class="btn btn-primary" aria-label="Update">
            <img src="/assets/Publish.png" alt="Update"> Update
          </button>
      </div>

      <div class="editor-toolbar">
        <button class="action-icon" aria-label="Bold">
          <img src="/assets/Bold.png" alt="Bold"> {{bold}}
        </button>
        <button class="action-icon" aria-label="Italic">
          <img src="/assets/Italic.png" alt="Italic"> {{italic}}
        </button>
        <button class="action-icon" aria-label="Link">
          <img src="/assets/Link.png" alt="Link"> {{link}}
        </button>
        <button class="action-icon" aria-label="Title_Editor">
          <img src="/assets/Title_Editor.png" alt="Title_Editor"> {{title_editor}}
        </button>
        <button class="action-icon" aria-label="Subtitle">
          <img src="/assets/Subtitle.png" alt="Subtitle"> {{subtitle}}
        </button>
        <button class="action-icon" aria-label="Quotation">
          <img src="/assets/Quotation.png" alt="Quotation"> {{quotation}}
        </button>
        <button class="action-icon" aria-label="Camera">
          <img src="/assets/Camera.png" alt="Camera"> {{camera}}
        </button>
      </div>

     
      <input type="text" class="blog-title-input" placeholder="Title">
      <hr class="title-separator">
      <div class="blog-content-editor" contenteditable="true" data-placeholder="Tell your story..."></div>
      
    </div>
  </div>
</section>