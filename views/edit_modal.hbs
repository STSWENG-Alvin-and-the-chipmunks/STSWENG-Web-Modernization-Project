<section class="under-fixed-nav"></section>

<div class="blog-create-container">
  <div class="editor-area">

    <div id="errorBox" class="blog-error-box" style="display:none; color:red; margin-bottom:1rem;"></div>

    {{!-- NOTE: same action & enctype; we'll override with fetch() anyway --}}
    <form
      id="blogForm"
      method="POST"
      action="/api/blogposts"
      enctype="multipart/form-data"
      data-mode="edit"
    >
      {{!-- Hidden original slug so backend knows which post to update --}}
      <input type="hidden" id="originalSlug" value="{{post.slug}}">

      <div class="top-actions">
        <button type="button" id="publishBtn" class="btn btn-primary" aria-label="Publish">
          <img src="/assets/Publish.png" alt="Publish"> Update
        </button>
      </div>

      {{!-- toolbar stays the same --}}


      {{!-- Title --}}
      <input
        type="text"
        class="blog-title-input"
        id="titleInput"
        name="title"
        placeholder="Title"
        value="{{post.title}}"
        required
      >
      <hr class="title-separator">
      {{!-- Slug (can be edited) --}}
      <input
        type="text"
        class="blog-slug-input"
        id="slugInput"
        name="slug"
        placeholder="Slug (e.g. my-first-post)"
        value="{{post.slug}}"
      >

      {{!-- Tags --}}
      <input
        type="text"
        class="blog-tags-input"
        name="tags"
        placeholder="Tags (comma-separated, e.g. hair, promo, new)"
        value="{{tagsString}}"
      >

      <hr class="title-separator">

      {{!-- Contenteditable with existing content --}}
      <div
        id="blogContentEditor"
        class="blog-content-editor"
        contenteditable="true"
        data-placeholder="Tell your story..."
      >{{{post.content}}}</div>

      <textarea id="contentField" name="content" hidden></textarea>
      <input type="hidden" id="isPublishedField" name="isPublished" value="{{#if post.isPublished}}true{{else}}false{{/if}}">
    </form>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('blogForm');
    const editor = document.getElementById('blogContentEditor');
    const contentField = document.getElementById('contentField');
    const isPublishedField = document.getElementById('isPublishedField');

    const saveDraftBtn = document.getElementById('saveDraftBtn');
    const publishBtn = document.getElementById('publishBtn');
    const previewBtn = document.getElementById('previewBtn');

    const titleInput = document.getElementById('titleInput');
    const slugInput = document.getElementById('slugInput');
    const errorBox = document.getElementById('errorBox');

    const originalSlugInput = document.getElementById('originalSlug'); // only exists in edit
    const isEdit = !!originalSlugInput; // true if on edit page

    let slugManuallyEdited = false;

    function slugify(text) {
      return text
        .toString()
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-');
    }

    if (titleInput) {
      titleInput.addEventListener('input', function () {
        if (!slugManuallyEdited) {
          slugInput.value = slugify(titleInput.value);
        }
      });
    }

    if (slugInput) {
      slugInput.addEventListener('input', function () {
        slugManuallyEdited = slugInput.value.trim().length > 0;
      });
    }

    function syncEditorToTextarea() {
      if (editor && contentField) {
        contentField.value = editor.innerHTML.trim();
      }
    }

    function showError(message, errorsArray) {
      if (!errorBox) return;
      let html = `<p>${message}</p>`;
      if (errorsArray && errorsArray.length) {
        html += '<ul>';
        errorsArray.forEach(e => {
          html += `<li>${e.msg || e}</li>`;
        });
        html += '</ul>';
      }
      errorBox.innerHTML = html;
      errorBox.style.display = 'block';
    }

    function clearError() {
      if (!errorBox) return;
      errorBox.innerHTML = '';
      errorBox.style.display = 'none';
    }

    // Draft: you can keep this as POST or also make it fetch() to /api/blogposts (up to you)
    if (saveDraftBtn) {
      saveDraftBtn.addEventListener('click', function () {
        clearError();
        syncEditorToTextarea();
        isPublishedField.value = 'false';
        form.submit(); // simplest; if you want draft-as-API, we can refactor this too
      });
    }

    if (publishBtn) {
      publishBtn.addEventListener('click', async function (event) {
        event.preventDefault();
        clearError();

        syncEditorToTextarea();
        isPublishedField.value = 'true';

        const formData = new FormData(form);

        // Decide URL + method
        let url = '/api/blogposts';
        let method = 'POST';

        if (isEdit) {
          const originalSlug = originalSlugInput.value;
          url = `/api/blogposts/${encodeURIComponent(originalSlug)}`; // matches router.put('/:slug', ...)
          method = 'PUT';
        }

        try {
          const res = await fetch(url, {
            method,
            body: formData
          });

          const data = await res.json().catch(() => ({}));

          if (!res.ok || !data.success) {
            const msg =
              data && data.message
                ? data.message
                : 'Failed to save the post. Please try again.';
            showError(msg, data.errors);
            return;
          }

          // On success, redirect to the post page
          if (data.post && data.post._id) {
            window.location.href = `/posts/${data.post._id}`;
          } else if (data.post && data.post.slug) {
            window.location.href = `/blog/${data.post.slug}`;
          } else {
            window.location.href = '/admin/blog';
          }
        } catch (err) {
          console.error(err);
          showError('An unexpected error occurred. Please try again.');
        }
      });
    }

    if (previewBtn) {
      previewBtn.addEventListener('click', function () {
        syncEditorToTextarea();
        const previewWin = window.open('', '_blank', 'width=800,height=600');
        previewWin.document.write(`
          <html>
            <head><title>Preview</title></head>
            <body>
              <h1>${titleInput ? (titleInput.value || '(No title)') : ''}</h1>
              ${contentField.value || '<p>(No content)</p>'}
            </body>
          </html>
        `);
        previewWin.document.close();
      });
    }
  });
</script>
