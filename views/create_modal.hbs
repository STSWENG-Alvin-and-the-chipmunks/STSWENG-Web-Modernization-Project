<section class="under-fixed-nav"></section>

<div class="blog-create-container">
  <div class="editor-area">

    <div id="errorBox" class="blog-error-box" style="display:none; color:red; margin-bottom:1rem;"></div>
    <form id="blogForm" method="POST" action="/api/blogposts" enctype="multipart/form-data">
      <div class="top-actions">
        <button type="button" id="publishBtn" class="btn btn-primary" aria-label="Publish">
          <img src="/assets/Publish.png" alt="Publish"> Publish
        </button>
      </div>
      
      {{!-- Title input (IMPORTANT: name="title") --}}
      <input
      type="text"
      class="blog-title-input"
      id="titleInput"
      name="title"
      placeholder="Title"
      required
      >

      <hr class="title-separator">

      <input
      type="text"
      class="blog-slug-input"
      id="slugInput"
      name="slug"
      placeholder="Slug (e.g. my-first-post)"
      >

      {{!-- Optional tags --}}
      <input
        type="text"
        class="blog-tags-input"
        name="tags"
        placeholder="Tags (comma-separated, e.g. hair, promo, new)"
      >

      <hr class="title-separator">

      {{!-- The contenteditable editor --}}
      <div
        id="blogContentEditor"
        class="blog-content-editor"
        contenteditable="true"
        data-placeholder="Tell your story..."
      ></div>

      {{!-- Hidden field that actually gets submitted as "content" --}}
      <textarea id="contentField" name="content" hidden></textarea>

      {{!-- Hidden field for publish vs draft --}}
      <input type="hidden" id="isPublishedField" name="isPublished" value="false">
    </form>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('blogForm');
    const editor = document.getElementById('blogContentEditor');
    const contentField = document.getElementById('contentField');
    const isPublishedField = document.getElementById('isPublishedField');

    const publishBtn = document.getElementById('publishBtn');

    const titleInput = document.getElementById('titleInput');
    const slugInput = document.getElementById('slugInput');
    const errorBox = document.getElementById('errorBox');

    let slugManuallyEdited = false;

    function slugify(text) {
      return text
        .toString()
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-');
    }

    titleInput.addEventListener('input', function () {
      if (!slugManuallyEdited) {
        slugInput.value = slugify(titleInput.value);
      }
    });

    slugInput.addEventListener('input', function () {
      slugManuallyEdited = slugInput.value.trim().length > 0;
    });

    function syncEditorToTextarea() {
      contentField.value = editor.innerHTML.trim();
    }

    function showError(message, errorsArray) {
      if (!errorBox) return;
      let html = `<p>${message}</p>`;
      if (errorsArray && errorsArray.length) {
        html += '<ul>';
        errorsArray.forEach(e => {
          html += `<li>${e.msg || e}</li>`;
        });
        html += '</ul>';
      }
      errorBox.innerHTML = html;
      errorBox.style.display = 'block';
    }

    function clearError() {
      if (!errorBox) return;
      errorBox.innerHTML = '';
      errorBox.style.display = 'none';
    }

    // Publish – use fetch so we can handle success/error nicely
    publishBtn.addEventListener('click', async function (event) {
      event.preventDefault();
      clearError();

      syncEditorToTextarea();
      isPublishedField.value = 'true';

      const formData = new FormData(form);

      try {
        const res = await fetch('/api/blogposts', {
          method: 'POST',
          body: formData
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok || !data.success) {
          // Validation or server error
          const msg =
            data && data.message
              ? data.message
              : 'Failed to publish the post. Please try again.';
          showError(msg, data.errors);
          return;
        }

        // SUCCESS: redirect to the new post page
        // You can choose slug or _id depending on what your frontend detail route uses
        if (data.post && data.post._id) {
          window.location.href = `/posts/${data.post._id}`;
        } else if (data.post && data.post.slug) {
          window.location.href = `/blog/${data.post.slug}`;
        } else {
          // Fallback if API didn't return a post object
          window.location.href = '/admin/blog';
        }
      } catch (err) {
        console.error(err);
        showError('An unexpected error occurred. Please try again.');
      }
    });
  });
</script>
